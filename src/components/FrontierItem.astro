---
// One outside paper (NBER or top-five journal) scored against the library.
interface Props { f: any; cons: Record<string, any>; byId: Record<string, any>; fill: (s: number) => number; hidden?: boolean; isNew?: boolean }
const { f, cons, byId, fill, hidden = false, isNew = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const LEVEL: Record<string, string> = { close: "紧密", related: "相关", far: "较远" };
const JOURNAL: Record<string, string> = { AER: "AER", JPE: "JPE", QJE: "QJE", RES: "REStud", ECTA: "Econometrica" };
const c = f.c ? cons[f.c] : null;
const authors = `${(f.authors || []).slice(0, 4).join(", ")}${(f.authors || []).length > 4 ? " 等" : ""}`;
---
<li style={c ? `--dot:${c.color}` : ""} hidden={hidden}
    data-j={f.journal || ""} data-fit={f.fit} data-score={f.score} data-date={f.date || ""}>
  <div class:list={["score", f.fit]} title={`相似度 ${f.score.toFixed(2)}`}>
    <span class="ring" style={`--p:${fill(f.score)}`}><b>{c ? c.lodge : "—"}</b></span>
    <span class="lvl">{LEVEL[f.fit] || ""}</span>
    <span class="sc mono">{f.score.toFixed(2)}</span>
  </div>
  <div class="body">
    <a class="t" href={f.url} target="_blank" rel="noopener">{f.title}</a>
    {f.title_cn && <p class="cn">{f.title_cn}</p>}
    <p class="m small">
      {f.journal ? (
        <><b class="jn">{JOURNAL[f.journal] || f.journal}</b> · <span class:list={[{ aop: !f.issue }]}>{f.issue ? `Vol. ${f.volume} No. ${f.issue}` : "提前在线"}</span> · 首次在线 {f.date}</>
      ) : f.id}
      {isNew && <span class="new">新</span>} · {authors}
    </p>
    <p class="links small">
      {c ? <span class="chip dot" style={`--dot:${c.color}`}>{c.lodge}宿 · {c.name}</span> : <span class="chip">库外主题</span>}
      <span class="muted">最接近：</span>
      {f.related.map((id: string) => byId[id] && <a href={`${base}papers/${id}/`} class="rel">{byId[id].authors_short} {byId[id].year}</a>)}
    </p>
    {f.abstract_cn
      ? <details><summary class="small muted">中文摘要</summary><p class="small abs">{f.abstract_cn}</p></details>
      : f.abstract && <details><summary class="small muted">摘要</summary><p class="small abs en">{f.abstract}</p></details>}
  </div>
</li>
<style>
  li[hidden] { display: none; }
  li { --dot: var(--muted); display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 16px; padding: 18px 0; }
  .score { display: flex; flex-direction: column; align-items: center; gap: 5px; padding-top: 2px; }
  /* ring fill = similarity; colour = nearest constellation */
  .ring { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--dot) calc(var(--p) * 1%), var(--surface-2) 0); }
  .ring b { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--bg); color: var(--dot); font: 500 16px var(--serif); }
  .far .ring { opacity: .55; }
  .lvl { font-size: 11px; color: var(--dot); }
  .far .lvl { color: var(--muted); }
  .sc { font-size: 10.5px; color: var(--muted); }
  .body { min-width: 0; }
  .t { font-family: var(--serif); font-size: 16.5px; line-height: 1.4; }
  .cn { margin: 2px 0 0; color: var(--text-2); }
  .m { margin: 4px 0; color: var(--muted); }
  .jn { font-weight: 600; color: var(--text-2); }
  .aop { color: var(--gold); }
  .new { display: inline-block; margin-left: 6px; padding: 0 6px; border-radius: 999px; background: var(--rose); color: var(--bg); font-size: 11px; font-weight: 600; line-height: 16px; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 6px 0 0; }
  .rel { color: var(--cyan); }
  .abs { color: var(--text-2); }
  .abs.en { font-family: var(--serif); }
</style>
