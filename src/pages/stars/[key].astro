---
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";
import YearStrip from "../../components/YearStrip.astro";
import { gist, splitLead, chrono } from "../../lib/papers";
import papers from "../../data/papers.json";
import constellations from "../../data/constellations.json";
import vocab from "../../data/vocab.json";
import lab from "../../data/lab.json";

export function getStaticPaths() {
  return constellations.map((c: any, i: number) => ({ params: { key: c.key }, props: { c, i } }));
}
const { c, i } = Astro.props as any;
const base = import.meta.env.BASE_URL;
const v: any = vocab;
const byId = Object.fromEntries(papers.map((p: any) => [p.id, p]));
const cons = Object.fromEntries(constellations.map((x: any) => [x.key, x]));
const md = (s: string) => marked.parse(s || "", { async: false }) as string;

const members = chrono(c.members.map((m: string) => byId[m]).filter(Boolean));
const star = byId[c.star];
const methodCount: Record<string, number> = {};
members.forEach((p: any) => p.methods.forEach((m: string) => (methodCount[m] = (methodCount[m] || 0) + 1)));
const topMethods = Object.entries(methodCount).sort((a, b) => b[1] - a[1]).slice(0, 6);
const years = members.map((p: any) => Number(p.year)).filter(Boolean);
const noted = members.filter((p: any) => p.notes.length).length;

// citations inside this constellation
const set = new Set(c.members);
const internal = members.flatMap((p: any) => p.cites.filter((x: string) => set.has(x)));

// strongest links to other constellations (citations in either direction)
const links: Record<string, number> = {};
lab.flow.forEach((f: any) => {
  if (f.from === c.key) links[f.to] = (links[f.to] || 0) + f.n;
  if (f.to === c.key) links[f.from] = (links[f.from] || 0) + f.n;
});
const neighbours = Object.entries(links).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([k, n]) => ({ c: cons[k], n }));

// timeline sections by decade
const decades: { label: string; items: any[] }[] = [];
members.forEach((p: any) => {
  const label = p.year ? `${Math.floor(Number(p.year) / 10) * 10} 年代` : "年份不详";
  if (decades.at(-1)?.label !== label) decades.push({ label, items: [] });
  decades.at(-1)!.items.push(p);
});

const prev = constellations[(i + constellations.length - 1) % constellations.length] as any;
const next = constellations[(i + 1) % constellations.length] as any;
---
<Layout title={`${c.lodge}宿 · ${c.name}`} active="stars" description={c.blurb}>
  <main class="page lodge-page" style={`--dot:${c.color}`}>
    <nav class="crumbs small muted"><a href={`${base}stars/`}>星宿</a> / {c.lodge}宿</nav>

    <header class="head">
      <span class="seal">{c.lodge}</span>
      <div>
        <p class="eyebrow">{c.lodge}宿 · 第 {i + 1} / {constellations.length} 个星宿</p>
        <h1>{c.name}</h1>
      </div>
    </header>
    {c.blurb && <p class="lede">{c.blurb}</p>}

    <div class="facts">
      <span><b>{members.length}</b> 篇</span>
      <span><b>{Math.min(...years)}–{Math.max(...years)}</b></span>
      <span><b>{internal.length}</b> 条星宿内引用</span>
      {noted > 0 && <span><b>{noted}</b> 篇有笔记</span>}
    </div>

    <div class="tags">
      <div class="chips">{c.keywords.map((k: string) => <a class="chip" href={`${base}rank/?q=${encodeURIComponent(k)}`}>{k}</a>)}</div>
      <div class="chips">{topMethods.map(([m, n]) => <a class="chip gold" href={`${base}rank/?m=${m}`}>{v.methods[m] || m} {n}</a>)}</div>
    </div>

    <section class="span">
      <YearStrip papers={members} star={c.star} size={9} ticks={[1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020]} />
    </section>

    <div class="top">
      {star && (
        <a class="anchor" href={`${base}papers/${star.id}/`}>
          <span class="lbl">距星 · 这个星宿的代表作</span>
          <span class="t">{star.title}</span>
          <span class="m">{star.authors_short} · {star.year}{star.venue ? ` · ${star.venue}` : ""}</span>
          <span class="gist">{gist(star)}</span>
        </a>
      )}
      {neighbours.length > 0 && (
        <aside class="near">
          <span class="lbl">联系最紧的星宿 <span class="muted">· 库内引用条数</span></span>
          <ul>
            {neighbours.map(({ c: o, n }) => (
              <li style={`--o:${o.color}`}>
                <a href={`${base}stars/${o.key}/`}><i>{o.lodge}</i>{o.name}</a><em>{n}</em>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <h2 class="sec">按时间读 <span class="muted small">从最早到最新，{members.length} 篇</span></h2>
    {decades.map((d) => (
      <section class="decade">
        <h3>{d.label}</h3>
        <ol class="rail">
          {d.items.map((p: any) => {
            const { lead, rest } = splitLead(p.summary);
            return (
              <li class:list={{ star: p.id === c.star }}>
                <span class="yr mono">{p.year}</span>
                <div class="body">
                  <a class="t" href={`${base}papers/${p.id}/`}>{p.title}</a>
                  <span class="m">
                    {p.authors_short}{p.venue ? ` · ${p.venue}` : ""}{p.metrics.cited_in_lib ? ` · 库内被引 ${p.metrics.cited_in_lib}` : ""}{p.rating ? ` · 评分 ${Number(p.rating).toFixed(1)}` : ""}
                  </span>
                  <span class="badges">
                    {p.id === c.star && <span class="b star">距星</span>}
                    {p.notes.length > 0 && <span class="b note">笔记 {p.notes.length}</span>}
                    {p.metrics.pinned
                      ? <span class="b" title="由人工指定归入本星宿">人工归入</span>
                      : p.metrics.conf < 0.5 && <span class="b" title={`连线置信度 ${p.metrics.conf}：多数连线落在其他星宿`}>边缘</span>}
                  </span>
                  <p class="gist">{gist(p)}</p>
                  {p.summary && (
                    <details>
                      <summary>完整简介</summary>
                      <div class="prose">
                        {lead && <p class="lead">{lead}</p>}
                        <Fragment set:html={md(rest)} />
                      </div>
                    </details>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <nav class="pager">
      <a href={`${base}stars/${prev.key}/`} style={`--o:${prev.color}`}><span class="muted small">← 上一个</span><span><i>{prev.lodge}</i>{prev.name}</span></a>
      <a href={`${base}stars/`} class="all small">全部星宿</a>
      <a href={`${base}stars/${next.key}/`} style={`--o:${next.color}`} class="nx"><span class="muted small">下一个 →</span><span><i>{next.lodge}</i>{next.name}</span></a>
    </nav>
  </main>
</Layout>
<style>
  .lodge-page { max-width: 1000px; }
  .head { display: flex; align-items: center; gap: 18px; margin-top: 18px; }
  .head h1 { margin: 2px 0 0; font-size: 32px; }
  .head .eyebrow { margin: 0; color: var(--dot); }
  .seal { flex: none; width: 64px; height: 64px; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--dot); color: var(--dot); font-family: var(--serif); font-size: 32px; box-shadow: 0 0 28px -8px var(--dot), inset 0 0 18px -10px var(--dot); }
  .lede { margin-top: 16px; font-size: 15.5px; line-height: 1.8; }
  .facts { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 16px; color: var(--muted); font-size: 13px; }
  .facts b { font-family: var(--serif); font-size: 18px; font-weight: 500; color: var(--text); margin-right: 3px; }
  .tags { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
  .span { margin: 30px 0 34px; }

  .top { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 18px; }
  .anchor { display: flex; flex-direction: column; gap: 5px; padding: 18px 20px; border-radius: var(--radius); border: 1px solid var(--border); border-left: 3px solid var(--dot); background: linear-gradient(90deg, color-mix(in srgb, var(--dot) 8%, transparent), var(--surface)); }
  .anchor:hover { color: inherit; border-color: var(--dot); }
  .lbl { font-size: 11.5px; letter-spacing: .08em; color: var(--dot); }
  .anchor .t { font-family: var(--serif); font-size: 19px; line-height: 1.4; }
  .anchor:hover .t { color: var(--dot); }
  .anchor .m { font-size: 12.5px; color: var(--muted); }
  .anchor .gist { margin-top: 4px; font-size: 14px; line-height: 1.75; color: var(--text-2); }
  .near { padding: 16px 18px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); }
  .near .lbl { color: var(--muted); }
  .near ul { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .near li { display: flex; align-items: baseline; gap: 8px; font-size: 13.5px; }
  .near a { flex: 1; min-width: 0; color: var(--text-2); }
  .near a:hover { color: var(--o); }
  .near i, .pager i { font-style: normal; font-family: var(--serif); color: var(--o); margin-right: 6px; }
  .near em { font-style: normal; font-family: var(--mono); font-size: 12px; color: var(--muted); }

  .sec { margin-top: 48px; display: flex; align-items: baseline; gap: 10px; }
  .decade h3 { margin: 26px 0 6px; font-size: 14px; letter-spacing: .1em; color: var(--dot); font-family: var(--sans); font-weight: 500; }
  .rail { list-style: none; margin: 0; padding: 0 0 0 4px; }
  .rail li { position: relative; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 14px; padding: 12px 0 14px 22px; border-left: 1px solid color-mix(in srgb, var(--dot) 35%, transparent); }
  .rail li::before { content: ""; position: absolute; left: -4.5px; top: 19px; width: 8px; height: 8px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--dot); }
  .rail li.star::before { background: #fff; box-shadow: 0 0 0 2px var(--dot), 0 0 10px var(--dot); border: none; }
  .yr { color: var(--muted); font-size: 13px; padding-top: 2px; }
  .body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .body .t { font-family: var(--serif); font-size: 16px; line-height: 1.45; color: var(--text); }
  .body .t:hover { color: var(--dot); }
  .body .m { font-size: 12.5px; color: var(--muted); }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .badges:empty { display: none; }
  .b { font-size: 11px; padding: 0 8px; line-height: 18px; border-radius: 999px; border: 1px solid var(--border-strong); color: var(--muted); }
  .b.star { border-color: var(--dot); color: var(--dot); }
  .b.note { border-color: rgba(232,196,122,.45); color: var(--gold); }
  .gist { margin: 4px 0 0; font-size: 13.5px; line-height: 1.7; color: var(--text-2); }
  details { margin-top: 4px; }
  details summary { cursor: pointer; font-size: 12.5px; color: var(--muted); width: max-content; }
  details summary:hover { color: var(--dot); }
  details .prose { margin-top: 10px; font-size: 14px; line-height: 1.8; padding: 14px 16px; border-radius: 8px; background: var(--surface); }
  .lead { font-family: var(--serif); font-size: 15px; color: var(--text); }

  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--border); }
  .pager a { display: flex; flex-direction: column; gap: 2px; font-family: var(--serif); font-size: 16px; }
  .pager a:hover { color: var(--o, var(--gold)); }
  .pager .nx { text-align: right; align-items: flex-end; }
  .pager .all { font-family: var(--sans); color: var(--muted); }

  @media (max-width: 760px) {
    .top { grid-template-columns: 1fr; }
    .seal { width: 52px; height: 52px; font-size: 26px; }
    .head h1 { font-size: 26px; }
    .rail li { grid-template-columns: 1fr; gap: 2px; padding-left: 18px; }
    .pager { grid-template-columns: 1fr 1fr; }
    .pager .all { display: none; }
  }
</style>
