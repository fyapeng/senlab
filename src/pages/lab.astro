---
import Layout from "../layouts/Layout.astro";
import PaperLine from "../components/PaperLine.astro";
import papers from "../data/papers.json";
import constellations from "../data/constellations.json";
import vocab from "../data/vocab.json";
import lab from "../data/lab.json";
import frontier from "../data/frontier.json";
import Heat from "../components/lab/Heat.astro";
import RatingMap from "../components/lab/RatingMap.astro";
import CitePath from "../components/lab/CitePath.astro";
import Toolbox from "../components/lab/Toolbox.astro";

const base = import.meta.env.BASE_URL;
const v: any = vocab;
const L: any = lab;
const byId = Object.fromEntries(papers.map((p: any) => [p.id, p]));
const cons = Object.fromEntries(constellations.map((c: any) => [c.key, c]));

// matrix: keep methods used at least twice
const methods = L.methods.filter((m: string) => L.matrix.reduce((s: number, r: any) => s + r.cells[m].length, 0) >= 2);
const maxCell = Math.max(...L.matrix.flatMap((r: any) => methods.map((m: string) => r.cells[m].length)));
const maxDec = Math.max(...L.timeline.flatMap((t: any) => t.counts));
const maxFlow = Math.max(1, ...L.flow.map((f: any) => f.n));
const maxKw = Math.max(...L.kw_top.map((k: any) => k.n));
const sortedKinds = Object.entries(L.by_kind).sort((a: any, b: any) => b[1] - a[1]);
const sortedCountries = Object.entries(L.by_country).sort((a: any, b: any) => b[1] - a[1]);
const maxKind = Math.max(...sortedKinds.map((x: any) => x[1]));
const maxCountry = Math.max(...sortedCountries.map((x: any) => x[1]));
---
<Layout title="探索实验室" active="lab">
  <main class="page wide">
    <header class="page-head">
      <p class="eyebrow">Lab</p>
      <h1>探索实验室</h1>
      <p class="lede">基于本库自身做的分析。本页全部由程序计算，每次更新文献库时自动重算。</p>
      <nav class="jump">
        <a href="#heat">热度对照</a><a href="#ratings">评分象限</a><a href="#path">引用路径</a><a href="#tools">方法工具箱</a>
        <a href="#matrix">方法 × 星宿</a><a href="#evolution">主题演化</a><a href="#bridges">桥梁与孤星</a><a href="#keywords">关键词与构成</a>
      </nav>
    </header>

    <section id="heat">
      <h2>热度对照 <span class="muted small">五大期刊的新文章落在哪些星宿，和你的收藏比一比</span></h2>
      <Heat papers={papers} constellations={constellations} frontier={frontier} />
    </section>

    <div class="grid cols-2 duo">
      <section id="ratings">
        <h2>评分象限 <span class="muted small">默认：术（执行）× 道（洞见），可切换任意两项</span></h2>
        <RatingMap papers={papers} cons={cons} dims={v.ratings} />
      </section>
      <section id="path">
        <h2>引用路径 <span class="muted small">任意两篇之间最短的库内引用链</span></h2>
        <CitePath papers={papers} cons={cons} />
      </section>
    </div>

    <section id="tools">
      <h2>方法工具箱 <span class="muted small">各篇「器」评分说明里可以拿来用的方法、框架与数据，按主要方法归类</span></h2>
      <Toolbox papers={papers} cons={cons} methods={v.methods} />
    </section>

    <section id="matrix">
      <h2>方法 × 星宿 <span class="muted small">格子里是篇数，空格是候选研究空白</span></h2>
      <div class="tablewrap">
        <table class="matrix">
          <thead><tr><th></th>{methods.map((m: string) => <th class="mh"><span>{v.methods[m]}</span></th>)}</tr></thead>
          <tbody>
            {L.matrix.map((r: any) => (
              <tr>
                <th class="rh"><span class="chip dot" style={`--dot:${cons[r.c].color}`}>{cons[r.c].lodge}·{cons[r.c].name}</span></th>
                {methods.map((m: string) => {
                  const n = r.cells[m].length;
                  return <td style={`--a:${n ? 0.15 + 0.75 * n / maxCell : 0}`} title={n ? r.cells[m].map((id: string) => `${byId[id].authors_short} ${byId[id].year}`).join("；") : "空白"}>{n || "·"}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="grid cols-2">
      <section id="evolution">
        <h2>主题演化 <span class="muted small">各星宿按发表年代的篇数</span></h2>
        <table class="spark">
          <thead><tr><th></th>{L.decades.map((d: number) => <th>{String(d).slice(2)}s</th>)}</tr></thead>
          <tbody>
            {L.timeline.map((t: any) => (
              <tr>
                <th><a href={`${base}stars/${t.c}/`} style={`--dot:${cons[t.c].color}`}><i class="seal">{cons[t.c].lodge}</i>{cons[t.c].name}</a></th>
                {t.counts.map((n: number, j: number) => (
                  <td><span class="bar" style={`height:${n ? 4 + 34 * n / maxDec : 0}px;background:${cons[t.c].color}`} title={`${cons[t.c].lodge}宿 · ${L.decades[j]} 年代 · ${n} 篇`}>{n >= 3 && <em>{n}</em>}</span></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
      <section>
        <h2>星宿间引用流 <span class="muted small">谁引用谁</span></h2>
        <ul class="list flows">
          {L.flow.slice(0, 12).map((f: any) => (
            <li>
              <span class="fname">
                <a href={`${base}stars/${f.from}/`} style={`--dot:${cons[f.from].color}`} title={cons[f.from].name}><i class="seal">{cons[f.from].lodge}</i>{cons[f.from].name}</a>
                <span class="arrow">→</span>
                <a href={`${base}stars/${f.to}/`} style={`--dot:${cons[f.to].color}`} title={cons[f.to].name}><i class="seal">{cons[f.to].lodge}</i>{cons[f.to].name}</a>
              </span>
              <span class="fbar"><i style={`width:${100 * f.n / maxFlow}%`}></i></span>
              <span class="mono small">{f.n}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="grid cols-2">
      <section id="bridges">
        <h2>桥梁文献 <span class="muted small">引用关系横跨多个星宿</span></h2>
        <ul class="list">
          {L.bridges.map((b: any) => (
            <li>
              <PaperLine p={byId[b.id]} cons={cons} />
              <span class="spans small">
                <span class="muted">连接 {b.spans.length} 个星宿</span>
                {b.spans.map((k: string) => <a class="seal" href={`${base}stars/${k}/`} style={`--dot:${cons[k].color}`} title={`${cons[k].lodge}宿 · ${cons[k].name}`}>{cons[k].lodge}</a>)}
              </span>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <h2>孤星 <span class="muted small">与库内其他文献没有引用关系（{L.lonely.length} 篇）</span></h2>
        <p class="muted small">它们只靠内容相似度挂在星宿上：或是方法论与背景文献，或是值得补齐上下游文献的线索。</p>
        <ul class="list">{L.lonely.slice(0, 12).map((id: string) => <li><PaperLine p={byId[id]} cons={cons} /></li>)}</ul>
      </section>
    </div>

    <div class="grid cols-2">
      <section id="keywords">
        <h2>关键词</h2>
        <p class="cloud">
          {L.kw_top.map((k: any) => <a href={`${base}rank/?q=${encodeURIComponent(k.k)}`} style={`font-size:${12 + 12 * k.n / maxKw}px;opacity:${0.55 + 0.45 * k.n / maxKw}`}>{k.k}</a>)}
        </p>
        <h3>常一起出现</h3>
        <p class="chips">{L.kw_pairs.slice(0, 16).map((p: any) => <span class="chip">{p.a} + {p.b} · {p.n}</span>)}</p>
      </section>
      <section>
        <h2>构成</h2>
        <h3>研究类型</h3>
        <ul class="bars">{sortedKinds.map(([k, n]: any) => <li><span>{v.kind[k] || "未标注"}</span><i style={`width:${100 * n / maxKind}%`}></i><b>{n}</b></li>)}</ul>
        <h3>情境国家</h3>
        <ul class="bars">{sortedCountries.map(([k, n]: any) => <li><span>{v.country[k] || "未标注"}</span><i style={`width:${100 * n / maxCountry}%`}></i><b>{n}</b></li>)}</ul>
      </section>
    </div>

    {import.meta.env.DEV && (
      <section class="card gen">
        <h2>生成层 <span class="chip">待运行 · 只在本机预览显示</span></h2>
        <p class="muted">星宿综述、跨星宿研究设想、结论分歧地图将由本地命令 <code>senlab lab</code> 生成（默认 DeepSeek），只在星宿成员或笔记变化时重算，结果标注模型与日期后发布在这里。</p>
      </section>
    )}
  </main>
</Layout>
<style>
  .wide { max-width: 1320px; }
  section[id] { scroll-margin-top: 70px; }
  .jump { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .jump a { font-size: 13px; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border-strong); color: var(--text-2); }
  .jump a:hover { border-color: var(--gold); color: var(--gold); }
  .duo { gap: 40px; align-items: start; }
  .tablewrap { overflow-x: auto; }
  .matrix { border-collapse: separate; border-spacing: 3px; font-size: 13px; }
  .matrix .mh { height: 120px; vertical-align: bottom; padding: 0 2px; }
  .matrix .mh span { writing-mode: vertical-rl; color: var(--muted); font-weight: 400; white-space: nowrap; }
  .matrix .rh { text-align: right; font-weight: 400; padding-right: 8px; white-space: nowrap; }
  .matrix td { width: 34px; height: 30px; text-align: center; border-radius: 5px; background: rgba(232, 196, 122, var(--a)); color: var(--text); font-variant-numeric: tabular-nums; }
  .matrix td:not([style*="--a:0;"]) { cursor: help; }
  .seal { display: inline-grid; place-items: center; flex: none; width: 20px; height: 20px; border-radius: 50%; border: 1px solid var(--dot); color: var(--dot); font: normal 12px var(--serif); }
  a.seal:hover { background: var(--dot); color: var(--bg); }
  .spark { border-collapse: collapse; font-size: 13px; width: 100%; table-layout: fixed; }
  .spark th { font-weight: 400; color: var(--muted); text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 2px 8px 2px 0; }
  .spark thead th:first-child { width: 42%; }
  .spark th a { display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); }
  .spark th a:hover { color: var(--dot); }
  .spark thead th { text-align: center; font-family: var(--mono); font-size: 11px; }
  .spark td { height: 46px; vertical-align: bottom; text-align: center; border-bottom: 1px solid var(--border); }
  .spark .bar { position: relative; display: inline-block; width: 70%; max-width: 22px; border-radius: 3px 3px 0 0; opacity: .85; }
  .spark .bar em { position: absolute; left: 0; right: 0; top: 2px; font: normal 10px var(--mono); color: var(--bg); }
  .flows li { display: grid; grid-template-columns: minmax(0, 1fr) 100px 28px; gap: 10px; align-items: center; padding: 7px 0; font-size: 13.5px; }
  .fname { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .fname a { display: inline-flex; align-items: center; gap: 6px; min-width: 0; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fname a:hover { color: var(--dot); }
  .arrow { color: var(--muted); flex: none; }
  .spans { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-top: 6px; }
  .spans .muted { margin-right: 4px; }
  .fbar { height: 6px; background: var(--surface-2); border-radius: 3px; overflow: hidden; }
  .fbar i { display: block; height: 100%; background: linear-gradient(90deg, var(--cyan), var(--gold)); }
  .cloud { line-height: 2; }
  .cloud a { margin-right: 12px; font-family: var(--serif); }
  .bars { list-style: none; padding: 0; margin: 0; }
  .bars li { display: grid; grid-template-columns: 110px 1fr 32px; gap: 10px; align-items: center; font-size: 13px; padding: 3px 0; }
  .bars i { height: 8px; border-radius: 4px; background: linear-gradient(90deg, rgba(232,196,122,.35), var(--gold)); }
  .bars b { font-weight: 500; text-align: right; color: var(--text-2); }
  .gen { margin-top: 40px; }
  .gen h2 { margin-top: 0; }
  code { font-family: var(--mono); background: var(--surface-2); padding: 1px 6px; border-radius: 4px; }
</style>
