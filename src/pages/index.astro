---
import Layout from "../layouts/Layout.astro";
import YearStrip from "../components/YearStrip.astro";
import { gist } from "../lib/papers";
import papers from "../data/papers.json";
import constellations from "../data/constellations.json";
import meta from "../data/meta.json";
import frontier from "../data/frontier.json";

const base = import.meta.env.BASE_URL;
const byId = Object.fromEntries(papers.map((p: any) => [p.id, p]));
const recent = [...papers].sort((a: any, b: any) => (b.added || "").localeCompare(a.added || "")).slice(0, 3);
// outside papers related to the library: NBER by relevance, top-5 journals newest first
const F: any = frontier;
const JN: Record<string, string> = { AER: "AER", JPE: "JPE", QJE: "QJE", RES: "REStud", ECTA: "ECTA" };
const nberNear = (F.papers || []).filter((f: any) => f.fit !== "far").slice(0, 3);
const top5New = (F.journals?.papers || []).filter((f: any) => f.fit !== "far")
  .sort((a: any, b: any) => (b.date || "").localeCompare(a.date || "") || b.score - a.score).slice(0, 3);

const [y0, y1] = meta.years;

const guide = constellations.map((c: any) => {
  const ms = c.members.map((id: string) => byId[id]).filter(Boolean);
  const years = ms.map((p: any) => Number(p.year)).filter(Boolean);
  const picks = ms.filter((p: any) => p.id !== c.star && p.rating)
    .sort((a: any, b: any) => b.rating - a.rating || a.metrics.rank - b.metrics.rank).slice(0, 2);
  return {
    ...c, ms, n: ms.length, from: Math.min(...years), to: Math.max(...years), picks,
    star: byId[c.star], noted: ms.filter((p: any) => p.notes.length).length,
  };
});
---
<Layout active="map" overlay>
  <section class="sky" id="sky">
    <canvas aria-label="文献星图：每颗星是一篇文献，亮度表示库内中心度，连线表示库内引用"></canvas>
    <div class="sky-intro">
      <p class="eyebrow">Literature Atlas</p>
      <h1>文献星图</h1>
      <p class="sky-stats">{meta.counts.papers} 颗星 · {meta.counts.constellations} 个星宿 · {meta.counts.citation_edges} 条库内引用</p>
      <p class="hint">星越亮，越是库内的中心文献；同色连线是星宿内的引用，淡蓝细线跨越星宿。悬停查看，点击打开；拖动平移，Ctrl + 滚轮或右下角按钮缩放。</p>
    </div>
    <ul class="legend">
      <li><button data-c="all" class="all">全部星宿</button></li>
      {constellations.map((c: any) => (
        <li><button data-c={c.key} style={`--dot:${c.color}`}><i></i><span class="lodge">{c.lodge}</span><span class="nm">{c.name}</span><em>{c.members.length}</em></button></li>
      ))}
    </ul>
    <div class="tip card" hidden></div>
    <div class="timebar">
      <button class="play btn" aria-label="播放时间">▶</button>
      <input type="range" aria-label="时间" />
      <span class="year small"></span>
      <span class="modes">
        <button class="btn on" data-mode="pub">按发表年</button>
        <button class="btn" data-mode="add">按收录时间</button>
      </span>
    </div>
    <div class="zoom">
      <button class="btn" data-zoom="in" aria-label="放大">＋</button>
      <button class="btn" data-zoom="out" aria-label="缩小">－</button>
      <button class="btn" data-zoom="reset" aria-label="复位">⟲</button>
    </div>
    <a class="scroll-hint" href="#guide">星宿导览 ↓</a>
  </section>

  <div class="strip" id="guide">
    <div class="seg facts">
      <span><b>{meta.counts.papers}</b> 篇文献</span>
      <span><b>{meta.counts.constellations}</b> 个星宿</span>
      <span><b>{meta.counts.with_notes}</b> 篇有笔记</span>
      <span class="muted">{y0}–{y1}</span>
    </div>
    <div class="seg">
      <span class="lbl">最近收录</span>
      {recent.map((p: any) => <a class="row" href={`${base}papers/${p.id}/`}><em>{p.authors_short} {p.year}</em> {p.title}</a>)}
    </div>
    <div class="seg">
      <a class="lbl" href={`${base}frontier/#journals`}>五大期刊 · 新近相关 <i>{(F.journals?.papers || []).length} 篇 →</i></a>
      {top5New.length
        ? top5New.map((f: any) => <a class="row" href={f.url} target="_blank" rel="noopener" title={f.title}><em>{JN[f.journal] || f.journal}</em> {f.title_cn || f.title}</a>)
        : <span class="row muted">暂无相关文章。</span>}
    </div>
    <div class="seg">
      <a class="lbl" href={`${base}frontier/#nber`}>NBER 本周{F.batch_date ? ` · ${F.batch_date}` : ""} <i>{(F.papers || []).filter((f: any) => f.fit !== "far").length} 篇 →</i></a>
      {nberNear.length
        ? nberNear.map((f: any) => <a class="row" href={f.url} target="_blank" rel="noopener" title={f.title}>{f.title_cn || f.title}</a>)
        : <span class="row muted">本周暂无相关文章。</span>}
    </div>
    <nav class="seg go">
      <a href={`${base}rank/`}>文库 · 排行 →</a>
      <a href={`${base}frontier/`}>前沿 →</a>
      <a href={`${base}lab/`}>实验室 →</a>
    </nav>
  </div>

  <main class="page guide">
    <header class="guide-head">
      <p class="eyebrow">Atlas · 星宿导览</p>
      <h2>十二星宿</h2>
      <p class="muted">星图里每一种颜色是一个研究主题。下面逐一说明它在问什么、从哪篇文献起步、哪几篇最值得先读。</p>
    </header>

    <div class="lodges">
      {guide.map((c: any) => (
        <article class="lcard" style={`--dot:${c.color}`}>
          <header>
            <span class="seal">{c.lodge}</span>
            <div class="ttl">
              <h3><a href={`${base}stars/${c.key}/`}>{c.name}</a></h3>
              <span class="muted small">{c.lodge}宿 · {c.n} 篇 · {c.from}–{c.to}{c.noted ? ` · ${c.noted} 篇有笔记` : ""}</span>
            </div>
            <button class="locate" data-c={c.key} title="回到星图并点亮这个星宿">星图中看 ↑</button>
          </header>

          <p class="blurb">{c.blurb}</p>

          <YearStrip papers={c.ms} star={c.star.id} />

          <div class="anchor">
            <span class="lbl">距星</span>
            <a href={`${base}papers/${c.star.id}/`}>
              <span class="t">{c.star.title}</span>
              <span class="m">{c.star.authors_short} · {c.star.year}{c.star.venue ? ` · ${c.star.venue}` : ""}</span>
            </a>
            <p class="gist">{gist(c.star)}</p>
          </div>

          {c.picks.length > 0 && (
            <ul class="picks">
              {c.picks.map((p: any) => (
                <li>
                  <a href={`${base}papers/${p.id}/`}>
                    <span class="t">{p.title}</span>
                    <span class="m">{p.authors_short} · {p.year} · 评分 {Number(p.rating).toFixed(1)}</span>
                  </a>
                  <p class="gist">{gist(p)}</p>
                </li>
              ))}
            </ul>
          )}

          <a class="more" href={`${base}stars/${c.key}/`}>进入{c.lodge}宿 · 全部 {c.n} 篇 →</a>
        </article>
      ))}
    </div>
  </main>
</Layout>

<script>
  import { initStarmap } from "../scripts/starmap.js";
  initStarmap(document.getElementById("sky"));

  // "星图中看": scroll back up and focus that constellation through the legend
  document.querySelectorAll<HTMLButtonElement>(".locate").forEach((b) => b.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
    const el = document.querySelector<HTMLButtonElement>(`.legend [data-c="${b.dataset.c}"]`);
    if (el && !el.classList.contains("on")) el.click();
  }));
</script>

<style>
  .sky { position: relative; height: 100vh; min-height: 560px; overflow: hidden; background: radial-gradient(ellipse at 50% 45%, #0f1a33 0%, #060a14 70%); }
  .sky canvas { position: absolute; inset: 0; display: block; touch-action: pan-y; }
  .sky-intro { position: absolute; left: 28px; top: 78px; max-width: 360px; pointer-events: none; }
  .sky-intro h1 { font-size: 40px; margin: 2px 0 4px; }
  .sky-stats { margin: 0; color: var(--gold); font-family: var(--serif); }
  .hint { color: var(--muted); font-size: 13px; margin-top: 10px; }
  .legend { position: absolute; left: 20px; bottom: 86px; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; max-height: 46vh; overflow: auto; }
  .legend button { display: flex; align-items: center; gap: 8px; background: none; border: 1px solid transparent; color: var(--text-2); font: 13px var(--sans); padding: 3px 10px; border-radius: 999px; cursor: pointer; text-align: left; }
  .legend button:hover, .legend button.on { border-color: var(--border-strong); background: rgba(6,10,20,.6); color: var(--text); }
  .legend i { width: 8px; height: 8px; border-radius: 50%; background: var(--dot); box-shadow: 0 0 8px var(--dot); flex: none; }
  .legend .lodge { font-family: var(--serif); color: var(--dot); width: 1.2em; }
  .legend em { font-style: normal; color: var(--muted); font-size: 11.5px; }
  .legend .all { color: var(--muted); }
  .tip { position: absolute; z-index: 5; width: 320px; display: flex; flex-direction: column; gap: 6px; background: rgba(9, 14, 28, 0.92); backdrop-filter: blur(8px); pointer-events: auto; }
  .tip[hidden] { display: none; }
  :global(.tip b) { font-family: var(--serif); font-size: 15.5px; line-height: 1.4; }
  :global(.tip .m) { font-size: 12.5px; color: var(--muted); }
  :global(.tip .open) { font-size: 13px; color: var(--gold); }
  :global(.tip .chip) { align-self: flex-start; }
  .timebar { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); display: flex; align-items: center; gap: 12px; padding: 8px 14px; border-radius: 999px; background: rgba(9, 14, 28, 0.78); border: 1px solid var(--border); backdrop-filter: blur(8px); }
  .timebar input { width: 260px; accent-color: var(--gold); }
  .timebar .year { min-width: 150px; color: var(--text-2); }
  .timebar .modes { display: flex; gap: 6px; }
  .timebar .btn { padding: 4px 10px; font-size: 12px; }
  .scroll-hint { position: absolute; right: 28px; bottom: 32px; color: var(--muted); font-size: 13px; }
  .zoom { position: absolute; right: 24px; bottom: 70px; display: flex; flex-direction: column; gap: 6px; }
  .zoom .btn { width: 34px; height: 34px; padding: 0; justify-content: center; font-size: 15px; background: rgba(9,14,28,.7); }
  @media (max-width: 760px) { .zoom { bottom: auto; top: 70px; right: 12px; } }
  /* info strip */
  .strip { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) auto; gap: 28px; max-width: 1320px; margin: 0 auto; padding: 18px 28px; border-bottom: 1px solid var(--border); font-size: 13px; scroll-margin-top: 56px; }
  .seg { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .seg .lbl { font-size: 11.5px; letter-spacing: .08em; color: var(--muted); margin-bottom: 2px; }
  a.lbl:hover { color: var(--gold); }
  .seg .lbl i { font-style: normal; letter-spacing: 0; margin-left: 4px; opacity: .8; }
  .seg .row { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-2); }
  .seg a.row:hover { color: var(--text); }
  .seg .row em { font-style: normal; color: var(--gold); margin-right: 4px; }
  .facts { gap: 4px; color: var(--text-2); }
  .facts b { font-family: var(--serif); font-size: 17px; color: var(--gold); font-weight: 500; margin-right: 2px; }
  .go { gap: 6px; }
  .go a { color: var(--gold); white-space: nowrap; }

  /* constellation guide */
  .guide { padding-top: 8px; }
  .guide-head { max-width: 640px; margin: 28px 0 22px; }
  .guide-head h2 { margin: 4px 0 8px; font-size: 26px; }
  .guide-head p:last-child { margin: 0; }
  .lodges { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .lcard { position: relative; display: flex; flex-direction: column; gap: 14px; padding: 20px 22px; border: 1px solid var(--border); border-top: 2px solid var(--dot); border-radius: var(--radius); background: linear-gradient(180deg, color-mix(in srgb, var(--dot) 7%, transparent), var(--surface) 140px); }
  .lcard header { display: flex; align-items: center; gap: 14px; }
  .seal { flex: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--dot); color: var(--dot); font-family: var(--serif); font-size: 22px; box-shadow: 0 0 18px -6px var(--dot); }
  .ttl { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .ttl h3 { margin: 0; font-family: var(--serif); font-size: 19px; font-weight: 500; line-height: 1.3; }
  .ttl h3 a { color: var(--text); }
  .ttl h3 a:hover { color: var(--dot); }
  .locate { flex: none; align-self: flex-start; background: none; border: 1px solid var(--border-strong); border-radius: 999px; color: var(--muted); font: 12px var(--sans); padding: 3px 10px; cursor: pointer; }
  .locate:hover { color: var(--dot); border-color: var(--dot); }
  .blurb { margin: 0; color: var(--text-2); font-size: 14px; line-height: 1.7; }
  .anchor, .picks li { display: flex; flex-direction: column; gap: 4px; }
  .anchor { padding: 12px 14px; border-radius: 8px; background: var(--surface-2); }
  .anchor .lbl { font-size: 11.5px; letter-spacing: .08em; color: var(--dot); }
  .lcard .t { display: block; font-family: var(--serif); font-size: 15px; line-height: 1.4; color: var(--text); }
  .lcard .m { display: block; font-size: 12px; color: var(--muted); margin-top: 1px; }
  .lcard a:hover .t { color: var(--dot); }
  .gist { margin: 2px 0 0; font-size: 13px; line-height: 1.65; color: var(--text-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .picks { list-style: none; margin: 0; padding: 0 2px; display: flex; flex-direction: column; gap: 12px; }
  .picks .gist { -webkit-line-clamp: 2; }
  .lcard .more { margin-top: auto; font-size: 13px; color: var(--dot); }
  @media (max-width: 1180px) {
    .strip { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr); }
    .facts { flex-direction: row; flex-wrap: wrap; gap: 4px 14px; grid-column: 1 / -1; }
    .go { flex-direction: row; flex-wrap: wrap; gap: 4px 16px; grid-column: 1 / -1; }
  }
  @media (max-width: 980px) {
    .strip { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .facts { flex-direction: row; flex-wrap: wrap; gap: 4px 14px; grid-column: 1 / -1; }
    .go { flex-direction: row; flex-wrap: wrap; gap: 4px 16px; grid-column: 1 / -1; }
    .lodges { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .strip { grid-template-columns: 1fr; gap: 16px; padding: 16px; }
    .lcard { padding: 16px; }
    .lcard header { flex-wrap: wrap; row-gap: 8px; }
    .ttl { flex-basis: calc(100% - 58px); }
    .locate { margin-left: 58px; }
    .sky-intro { left: 16px; top: 70px; }
    .sky-intro h1 { font-size: 30px; }
    .hint { display: none; }
    .legend { display: none; }
    .timebar { width: calc(100% - 24px); flex-wrap: wrap; justify-content: center; border-radius: 16px; bottom: 14px; }
    .timebar input { width: 100%; order: 3; }
    .scroll-hint { display: none; }
  }
</style>
