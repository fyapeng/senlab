---
import Layout from "../layouts/Layout.astro";
import FrontierItem from "../components/FrontierItem.astro";
import papers from "../data/papers.json";
import constellations from "../data/constellations.json";
import frontier from "../data/frontier.json";

const F = frontier as any;
const byId = Object.fromEntries(papers.map((p: any) => [p.id, p]));
const cons = Object.fromEntries(constellations.map((c: any) => [c.key, c]));
const ref = F.ref || {};
// only papers close or related to the library are listed; the rest are counted
const near = (xs: any[]) => (xs || []).filter((f: any) => f.fit !== "far");
const nber = near(F.papers);
const nberFar = (F.papers || []).length - nber.length;
const j5 = near(F.journals?.papers);
const j5Far = F.journals?.far ?? 0;
const SHOW = 8;
const nClose = (xs: any[]) => xs.filter((f: any) => f.fit === "close").length;
const [sy, sm] = (F.journals?.since || "").split("-");
const sinceLabel = sy ? `${sy} 年${Number(sm) === 1 ? "以来" : ` ${Number(sm)} 月以来`}` : "";
// ring fill: 0 a little below the "related" cut, full at the "close" cut
const lo = (ref.p5 ?? 0.8) - 0.1, hi = ref.p25 ?? 0.9;
const fill = (s: number) => Math.round(100 * Math.max(0.04, Math.min(1, (s - lo) / (hi - lo))));

const columns = [
  { id: "journals", title: "五大期刊", sub: sinceLabel, items: j5, far: j5Far,
    src: "Top 5 Journals", href: "https://fyapeng.com/top5papers/",
    after: `（AER、JPE、QJE、REStud、Econometrica）${F.journals?.updated ? `，更新于 ${F.journals.updated}` : ""}` },
  { id: "nber", title: "NBER 本周", sub: F.batch_date || "", items: nber, far: nberFar,
    src: "NBER Weekly", href: "https://fyapeng.com/nber/", after: "" },
];
---
<Layout title="前沿" active="frontier">
  <main class="page wide">
    <header class="page-head">
      <p class="eyebrow">Frontier</p>
      <h1>前沿</h1>
      <p class="lede">库外的新论文中，与本库紧密或相关的文章，按相近程度排序。左侧圆环的颜色是最接近的星宿，填满程度是相近程度（填满即达到"紧密"）；每篇另标出最接近的库内文献。</p>
      <details class="method small">
        <summary>相近程度怎么算</summary>
        <p>每篇按内容与本库文献的相似度排序。相似度以库内文献与自身最近邻的相似度为参照：不低于其第 25 百分位（{ref.p25 ?? "—"}）为"紧密"，不低于第 5 百分位（{ref.p5 ?? "—"}）为"相关"并标出所属星宿，更低的为"较远"、属库外主题，不在这里列出。</p>
      </details>
      <nav class="jump">{columns.map((col) => <a href={`#${col.id}`}>{col.title} <em>{col.items.length}</em></a>)}</nav>
    </header>

    <div class="cols">
      {columns.map((col) => (
        <section id={col.id} class="col">
          <header class="col-head">
            <h2>{col.title} <span class="sub">{col.sub}</span></h2>
            <p class="small muted">
              相关 <b>{col.items.length}</b> 篇{nClose(col.items) ? `，其中紧密 ${nClose(col.items)} 篇` : ""}{col.far ? ` · 另有 ${col.far} 篇库外主题未列出` : ""}
            </p>
            <p class="small muted src">来自 <a href={col.href} class="lnk">{col.src}</a>{col.after}</p>
          </header>
          {col.items.length === 0 ? <p class="muted small">暂无相关文章。</p> : (
            <ol class="list fl" data-list>
              {col.items.map((f: any, i: number) => <FrontierItem f={f} cons={cons} byId={byId} fill={fill} hidden={i >= SHOW} />)}
            </ol>
          )}
          {col.items.length > SHOW && (
            <button type="button" class="btn more" data-more data-n={col.items.length}>展开全部 {col.items.length} 篇</button>
          )}
        </section>
      ))}
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-more]").forEach((b) => b.addEventListener("click", () => {
    const list = b.closest(".col")!.querySelector("[data-list]")!;
    const open = b.dataset.open === "1";
    list.querySelectorAll<HTMLElement>(":scope > li").forEach((li, i) => { li.hidden = open && i >= 8; });
    b.dataset.open = open ? "" : "1";
    b.textContent = open ? `展开全部 ${b.dataset.n} 篇` : "收起";
    if (open) b.closest(".col")!.scrollIntoView({ block: "start" });
  }));
</script>

<style>
  .wide { max-width: 1320px; }
  .lnk { color: var(--cyan); }
  .method { margin-top: 12px; color: var(--text-2); max-width: 760px; }
  .method summary { cursor: pointer; color: var(--muted); width: max-content; }
  .method summary:hover { color: var(--gold); }
  .method p { margin: 8px 0 0; line-height: 1.8; }
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; margin-top: 8px; }
  .col { min-width: 0; scroll-margin-top: 70px; }
  .col-head { position: sticky; top: 58px; z-index: 2; padding: 12px 0 10px; background: linear-gradient(var(--bg) 85%, transparent); border-bottom: 1px solid var(--border); }
  .col-head h2 { margin: 0; font-size: 22px; display: flex; align-items: baseline; gap: 10px; }
  .col-head .sub { font-family: var(--sans); font-size: 13px; font-weight: 400; color: var(--muted); }
  .col-head p { margin: 4px 0 0; }
  .col-head b { color: var(--gold); font-weight: 600; }
  .src { margin-top: 2px; }
  .more { margin-top: 14px; }
  /* stacked columns on narrow screens: jump links so NBER is one tap away */
  .jump { display: none; gap: 8px; margin-top: 14px; }
  .jump a { padding: 5px 14px; border-radius: 999px; border: 1px solid var(--border-strong); color: var(--text-2); font-size: 13.5px; }
  .jump em { font-style: normal; color: var(--muted); margin-left: 4px; }
  @media (max-width: 980px) {
    .jump { display: flex; }
    .cols { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .col-head { position: static; }
  }
</style>
