---
import "../styles/global.css";
import meta from "../data/meta.json";

interface Props { title?: string; active?: string; overlay?: boolean; description?: string }
const { title, active = "", overlay = false, description = "SenciumLab：付亚鹏的个人文献库，文献星图、排行、详细简介与读书笔记。" } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ["map", "星图", ""],
  ["rank", "文库", "rank/"],
  ["stars", "星宿", "stars/"],
  ["frontier", "前沿", "frontier/"],
  ["lab", "实验室", "lab/"],
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · SenciumLab` : "SenciumLab · 文献星图"}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class:list={["topbar", { overlay }]}>
      <a class="brand" href={base}><b>SenciumLab</b><span>文献星图 · {meta.counts.papers} 篇</span></a>
      <nav class="nav">
        {nav.map(([key, label, href]) => <a href={`${base}${href}`} class:list={{ on: active === key }}>{label}</a>)}
      </nav>
    </header>
    <slot />
    {!overlay && (
      <footer class="footer">
        <span>SenciumLab · 付亚鹏的文献库 · 数据更新于 {meta.built} · 中心度口径：库内引用 PageRank（自 2026-10-24）</span>
        <span>简介与笔记为个人阅读记录；准确引用请回到原文。</span>
      </footer>
    )}
  </body>
</html>
